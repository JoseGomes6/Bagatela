# Copiar para .env (local) ou definir nas variáveis de ambiente da plataforma (Vercel > Settings > Environment Variables).
# NUNCA colocar chaves no código nem no frontend.

# Obrigatória: chave da API de IA (Anthropic). Só é lida em api/generate-concept.js.
AI_API_KEY=

# Opcionais
# Modelo usado para gerar o conceito (por defeito claude-opus-5-5).
AI_MODEL=
# Origens autorizadas a chamar a API, separadas por vírgulas (por defeito www.bagatela.pt e bagatela.pt).
ALLOWED_ORIGINS=https://www.bagatela.pt,https://bagatela.pt
# Limites por IP/hora e total por dia (por instância serverless).
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=400
