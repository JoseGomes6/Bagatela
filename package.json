{
  "name": "bagatela-website",
  "private": true,
  "version": "2.0.0",
  "description": "Site da Bagatela em React + TypeScript, pré-renderizado (4 idiomas) para alojamento estático.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --open /dev/index.html",
    "build": "cross-env NODE_ENV=production tsx scripts/build.ts",
    "build:site": "cross-env NODE_ENV=production tsx scripts/build.ts --publish",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
